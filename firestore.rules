rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function validReservation(data) {
      return data.keys().hasOnly([
          'customerName',
          'submissionId',
          'customerPhone',
          'customerEmail',
          'serviceDate',
          'time',
          'guests',
          'hall',
          'notes',
          'status',
          'createdAt'
        ])
        && data.keys().hasAll([
          'customerName',
          'submissionId',
          'customerPhone',
          'customerEmail',
          'serviceDate',
          'time',
          'guests',
          'hall',
          'notes',
          'status',
          'createdAt'
        ])
        && data.submissionId is string
        && data.submissionId.size() >= 32
        && data.submissionId.size() <= 64
        && data.customerName is string
        && data.customerName.size() >= 2
        && data.customerName.size() <= 100
        && data.customerPhone is string
        && data.customerPhone.size() >= 7
        && data.customerPhone.size() <= 20
        && data.customerEmail is string
        && data.customerEmail.size() >= 5
        && data.customerEmail.size() <= 254
        && data.serviceDate is string
        && data.serviceDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string
        && data.time in [
          '12:00', '12:30', '13:00', '13:30', '14:00', '14:30',
          '15:00', '15:30', '16:00', '16:30', '17:00', '17:30',
          '18:00', '18:30', '19:00', '19:30', '20:00'
        ]
        && data.guests is int
        && data.guests >= 1
        && data.guests <= 20
        && data.hall in ['Sala Główna', 'Sala VIP', 'Ogródek Letni']
        && data.notes is string
        && data.notes.size() <= 500
        && data.status == 'pending'
        && data.createdAt is timestamp
        && data.createdAt >= request.time - duration.value(5, 'm')
        && data.createdAt <= request.time + duration.value(1, 'm');
    }

    match /reservations/{reservationId} {
      allow create: if reservationId == request.resource.data.submissionId
        && validReservation(request.resource.data);
      allow get: if isStaff();
      allow list: if isStaff() && request.query.limit <= 100;
      allow update: if reservationId == resource.data.submissionId
        && request.resource.data == resource.data;
      allow delete: if false;
    }

    match /staff/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
